# Copy to .env — never commit the filled-in version.

# --- Source 2: backlink link-gap (optional) ---------------------------------
# Ahrefs API. Unset = ahrefs-linkgap.mjs skips loudly and exits 0.
AHREFS_API_KEY=

# --- Source 3: fresh listicles (optional, best converting) -------------------
# Firehose tap token. Required by citation-radar.mjs.
FIREHOSE_TAP_TOKEN=

# --- Classifier (required by citation-radar.mjs) -----------------------------
# Any OpenAI-compatible endpoint; set classifier.base_url in config.json to point
# somewhere else. Batched gpt-4o-mini costs about $1-2/month at our volume.
OPENAI_API_KEY=

# --- Source 1: the citation-gap scan ----------------------------------------
# Handled by your AI-visibility tool's own connector (Peec, Profound, AirOps...),
# not by these scripts. The Radar prompt drives it.
